<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navRail"
        android:layout_width="@dimen/vs_230"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/vs_20"
        android:layout_marginTop="@dimen/vs_20"
        android:layout_marginRight="@dimen/vs_6"
        android:layout_marginBottom="@dimen/vs_20"
        android:background="@drawable/bg_glass_rail"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_14"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_14"
        android:paddingBottom="@dimen/vs_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="@dimen/vs_76"
                android:layout_height="@dimen/vs_76"
                android:background="@drawable/bg_avatar_ring"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_lingqi"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_14"
                android:layout_weight="1"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1mm"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@color/glass_stroke" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="0mm"
            app:tv_selectedItemIsCentered="false"
            app:tv_verticalSpacingWithMargins="@dimen/vs_6" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/vs_0"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/vs_20"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_14"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_marginRight="@dimen/vs_20"
            android:background="@drawable/bg_glass_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="@dimen/vs_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="right|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:textAlignment="gravity"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_24"
                tools:text="2026/06/16  周二  15:01" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_0"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topLayout">

            <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
                android:id="@+id/mViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
