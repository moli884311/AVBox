<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_cinema"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_400"
        android:scaleType="centerCrop"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:contentDescription="@string/app_name" />

    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_400"
        android:background="@drawable/bg_hero_scrim"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_64"
            android:background="@drawable/bg_cinema_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/vs_44"
                android:layout_height="@dimen/vs_44"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/vs_4"
                android:src="@drawable/icon_lingqi"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/navHistory"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_24"
                android:text="历史" />

            <TextView
                android:id="@+id/navLive"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_14"
                android:text="直播" />

            <TextView
                android:id="@+id/navSearch"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_14"
                android:text="搜索" />

            <TextView
                android:id="@+id/navPush"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_14"
                android:text="推送" />

            <TextView
                android:id="@+id/navCollect"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_14"
                android:text="收藏" />

            <TextView
                android:id="@+id/navSetting"
                style="@style/HomeTopNav"
                android:layout_marginStart="@dimen/vs_14"
                android:text="设置" />

            <View
                android:layout_width="@dimen/vs_0"
                android:layout_height="1mm"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="right|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="@dimen/vs_260"
                android:text="@string/app_name"
                android:textColor="@color/cinema_text_secondary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_20"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="right|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/cinema_text_secondary"
                android:textSize="@dimen/ts_22"
                tools:text="2026/09/25  周五  21:30" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/heroInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginLeft="@dimen/vs_70"
                android:layout_marginRight="@dimen/vs_70"
                android:layout_marginBottom="@dimen/vs_24"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="@dimen/vs_700"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="沫离影视"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="@dimen/ts_50"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/cinema_gold"
                    android:textSize="@dimen/ts_24" />

                <TextView
                    android:id="@+id/tvHeroDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:ellipsize="end"
                    android:lineSpacingExtra="4mm"
                    android:maxLines="2"
                    android:maxWidth="@dimen/vs_760"
                    android:textColor="@color/cinema_text_secondary"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>
        </FrameLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_70"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_selectedItemIsCentered="false" />

        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_250"
            android:layout_marginTop="@dimen/vs_10"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
                android:id="@+id/mViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
