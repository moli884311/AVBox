<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sel_setting_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_15"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_15">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:background="@drawable/bg_setting_icon"
            android:contentDescription="@null"
            android:focusable="false"
            android:padding="@dimen/vs_14"
            android:tint="@color/cinema_gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_24"
            android:layout_weight="1"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/cinema_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/rowSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/cinema_text_secondary"
                android:textSize="@dimen/ts_18"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_12"
            android:ellipsize="end"
            android:focusable="false"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/cinema_text_secondary"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_12"
            android:focusable="false"
            android:includeFontPadding="false"
            android:text="&gt;"
            android:textColor="@color/cinema_text_secondary"
            android:textSize="@dimen/ts_30" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1mm"
        android:layout_marginStart="@dimen/vs_108"
        android:background="#14FFFFFF" />
</LinearLayout>
