<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_cinema">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_60"
            android:paddingTop="@dimen/vs_30"
            android:paddingRight="@dimen/vs_60"
            android:paddingBottom="@dimen/vs_40">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="设置"
                android:textColor="@color/cinema_text_primary"
                android:textSize="@dimen/ts_50"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_24"
                android:layout_marginBottom="@dimen/vs_28"
                android:background="@drawable/bg_setting_card_accent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/vs_28">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="归零box"
                        android:textColor="@color/cinema_text_primary"
                        android:textSize="@dimen/ts_50"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:includeFontPadding="false"
                        android:text="TVBox 原生版"
                        android:textColor="@color/cinema_text_secondary"
                        android:textSize="@dimen/ts_22" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_14"
                        android:background="@drawable/bg_nav_item"
                        android:includeFontPadding="false"
                        android:paddingLeft="@dimen/vs_20"
                        android:paddingTop="@dimen/vs_6"
                        android:paddingRight="@dimen/vs_20"
                        android:paddingBottom="@dimen/vs_6"
                        android:textColor="@color/cinema_gold"
                        android:textSize="@dimen/ts_20" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="@dimen/vs_120"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:src="@drawable/icon_lingqi" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_8">

                <include
                    android:id="@+id/rowConfig"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowTheme"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowPlay"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowDanmu"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowTmdb"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowPrefer"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowPreload"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_8">

                <include
                    android:id="@+id/rowDefaultPage"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowHistory"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowCache"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowDoh"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_8">

                <include
                    android:id="@+id/rowAbout"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowUpdate"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_12"
                android:includeFontPadding="false"
                android:text="更多"
                android:textColor="@color/cinema_text_secondary"
                android:textSize="@dimen/ts_22" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_8">

                <include
                    android:id="@+id/rowBackup"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowDebug"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
