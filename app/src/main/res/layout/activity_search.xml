<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="@dimen/vs_20">

    <!-- 左侧: 键盘区 -->
    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:background="@drawable/input_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_30"
                android:layout_height="@dimen/vs_30"
                android:src="@drawable/icon_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@null"
                android:hint="输入影片/演员的首字母或全拼"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
            android:id="@+id/keyBoardRoot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/keyboardModeFull"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_mode_bg"
                android:focusable="true"
                android:gravity="center"
                android:text="全键盘"
                android:textColor="@color/search_key_text"
                android:textSize="@dimen/ts_20" />

            <Space
                android:layout_width="@dimen/vs_10"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/keyboardModeT9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_mode_bg"
                android:focusable="true"
                android:gravity="center"
                android:text="T9 键盘"
                android:textColor="@color/search_key_text"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_key_bg"
                android:focusable="true"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/search_key_text"
                android:textSize="@dimen/ts_20" />

            <Space
                android:layout_width="@dimen/vs_10"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvRemoteSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_key_bg"
                android:focusable="true"
                android:gravity="center"
                android:text="手机搜索"
                android:textColor="@color/search_key_text"
                android:textSize="@dimen/ts_20" />

            <Space
                android:layout_width="@dimen/vs_10"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvSearchCheckboxBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_key_bg"
                android:focusable="true"
                android:gravity="center"
                android:text="指定搜索源"
                android:textColor="@color/search_key_text"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchMicHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:text="试试长按语音键唤起语音搜索"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右侧: 推荐 / 结果区 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/llRecommend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wordSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.06"
                    android:text="搜索推荐"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="@dimen/ts_24"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/searchRecommendSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vs_40"
                    android:background="@drawable/search_chip_bg"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="换一换"
                    android:textColor="@color/search_chip_text"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingRight="@dimen/vs_10"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_8"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_8" />

            <TextView
                android:id="@+id/featuredTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:letterSpacing="0.06"
                android:text="精选推荐"
                android:textColor="@color/cinema_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/featuredGrid"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_240"
                android:layout_marginTop="@dimen/vs_6"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

            <TextView
                android:id="@+id/hotPlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:letterSpacing="0.06"
                android:text="热门播放"
                android:textColor="@color/cinema_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/hotPlayGrid"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_240"
                android:layout_marginTop="@dimen/vs_6"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingRight="@dimen/vs_20"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
