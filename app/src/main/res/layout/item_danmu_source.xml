<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/button_danmu_setting">

    <LinearLayout
        android:id="@+id/danmuSourceItem"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginBottom="@dimen/vs_10"
        android:background="@drawable/shape_setting_sort_focus"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/danmuSourceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/danmuSourceUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/dialog_text_hint"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <TextView
            android:id="@+id/danmuSourceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_10"
            android:layout_marginLeft="@dimen/vs_10"
            android:gravity="center_vertical"
            android:textColor="@color/danmu_status_idle"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>
</FrameLayout>
