<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item
        android:bottom="4mm"
        android:left="2mm"
        android:right="2mm"
        android:top="2mm">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_tint"
                android:startColor="@color/glass_tint_strong"
                android:type="linear" />
            <stroke
                android:width="1mm"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
