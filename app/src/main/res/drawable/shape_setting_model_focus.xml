<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_tint_strong"
                android:startColor="@color/glass_highlight"
                android:type="linear" />
            <stroke android:width="1mm" android:color="@color/brand_accent" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <solid android:color="@color/glass_tint" />
            <stroke android:width="1mm" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
