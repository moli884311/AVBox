<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E6080B12"
                android:centerColor="#66080B12"
                android:endColor="#00080B12"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#CC05070B"
                android:centerColor="#3305070B"
                android:endColor="#0005070B"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
