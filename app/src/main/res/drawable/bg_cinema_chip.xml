<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <gradient
                android:angle="0"
                android:endColor="@color/cinema_red_dark"
                android:startColor="@color/cinema_red"
                android:type="linear" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="@color/cinema_nav_focus_bg" />
            <stroke
                android:width="1mm"
                android:color="@color/cinema_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="@color/cinema_chip_bg" />
            <stroke
                android:width="1mm"
                android:color="@color/cinema_chip_stroke" />
        </shape>
    </item>
</selector>
