<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="@color/detail_button_bg_focus" />
            <stroke android:width="2mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="@color/detail_button_bg" />
            <stroke android:width="1mm" android:color="@color/detail_button_stroke" />
        </shape>
    </item>
</selector>
